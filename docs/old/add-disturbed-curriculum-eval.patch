     def progress_callback(num_steps, metrics):
@@ -699,6 +800,17 @@ def main():
     with open(run_dir / "REWARD_AUDIT_SUMMARY.txt", "w") as f:
         f.write("\n".join(summary_lines) + "\n")
 
