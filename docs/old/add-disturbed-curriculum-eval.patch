     parser.add_argument("--target_kl", type=float, default=0.02)
+    # [2026-09-22 追加] 外乱カリキュラムを固定進捗率で評価する専用eval。
+    # Brax標準のEvaluatorはeval_envをreset()するたびtraining_progressが
+    # 0に戻る仕様のため、通常のeval/*指標は外乱カリキュラムが
