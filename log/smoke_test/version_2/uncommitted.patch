+    model = helper.make_model(graph, opset_imports=[helper.make_opsetid("", OPSET)])
+    model.ir_version = min(model.ir_version, 9)  # 古い onnxruntime でも読めるように
+    onnx.checker.check_model(model)
+    return model
+
