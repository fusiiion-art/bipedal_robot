@@ -147,6 +147,26 @@ def quat_to_euler(q) -> np.ndarray:
 
 
 
+# ============================================================
+# 重力射影ベクトル (docs/master_plan.md §1.3 の姿勢観測)
+# ============================================================
+# 胴体座標系で見た「下向きの単位ベクトル」。オイラー角と違いヨー(実機BNO055では
+# 磁北基準の絶対方位)を含まず、特異点・角度の折り返しも無い。直立時は [0, 0, -1]。
+# q = [w, x, y, z] は胴体→ワールドの回転なので、ワールドの [0,0,-1] を逆回転する:
+#   g_body = R(q)^T [0,0,-1] = -(R の3行目) = -[2(xz - wy), 2(yz + wx), 1 - 2(x²+y²)]
+
+def projected_gravity_numpy(q: np.ndarray) -> np.ndarray:
+    q = np.asarray(q, dtype=np.float64)
+    q = q / max(np.linalg.norm(q), 1e-8)
+    w, x, y, z = q
+    return -np.array([2.0 * (x * z - w * y), 2.0 * (y * z + w * x), 1.0 - 2.0 * (x * x + y * y)])
+
+
+def projected_gravity_jax(q: "jax.Array") -> "jax.Array":
+    w, x, y, z = q[0], q[1], q[2], q[3]
+    return -jp.stack([2.0 * (x * z - w * y), 2.0 * (y * z + w * x), 1.0 - 2.0 * (x * x + y * y)])
+
